# Server Configuration
PORT=3000

# Neon Serverless PostgreSQL Connection String
# Use the Pooled connection string from your Neon dashboard
# Format: postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require

# Admin Authentication & Security
ADMIN_PASSWORD=your_secure_admin_password_here
SESSION_SECRET=your_random_32_character_session_secret_here
